[
 {
  "id": 0,
  "lines": [
   "我是从{Y}年1月1日穿越回来的，",
   "当时的遗憾还记得吗？",
   "现在又拥有了一次重来的机会，",
   "我会做出什么改变？"
  ],
  "by": ""
 },
 {
  "id": 1,
  "lines": [
   "君不见黄河之水天上来，",
   "奔流到海不复回。",
   "君不见高堂明镜悲白发，",
   "朝如青丝暮成雪。"
  ],
  "by": "李白《将进酒》"
 },
 {
  "id": 2,
  "lines": [
   "今人不见古时月，",
   "今月曾经照古人。",
   "古人今人若流水，",
   "共看明月皆如此。"
  ],
  "by": "李白《把酒问月》"
 },
 {
  "id": 3,
  "lines": [
   "生者为过客，",
   "死者为归人。",
   "天地一逆旅，",
   "同悲万古尘。"
  ],
  "by": "李白《拟古》"
 },
 {
  "id": 4,
  "lines": [
   "少壮能几时，",
   "鬓发各已苍。",
   "访旧半为鬼，",
   "惊呼热中肠。"
  ],
  "by": "杜甫《赠卫八处士》"
 },
 {
  "id": 5,
  "lines": [
   "江碧鸟逾白，",
   "山青花欲燃。",
   "今春看又过，",
   "何日是归年？"
  ],
  "by": "杜甫《绝句二首》"
 },
 {
  "id": 6,
  "lines": [
   "春眠不觉晓，",
   "处处闻啼鸟。",
   "夜来风雨声，",
   "花落知多少。"
  ],
  "by": "孟浩然《春晓》"
 },
 {
  "id": 7,
  "lines": [
   "前不见古人，",
   "后不见来者。",
   "念天地之悠悠，",
   "独怆然而涕下。"
  ],
  "by": "陈子昂《登幽州台歌》"
 },
 {
  "id": 8,
  "lines": [
   "江畔何人初见月？",
   "江月何年初照人？",
   "人生代代无穷已，",
   "江月年年望相似。"
  ],
  "by": "张若虚《春江花月夜》"
 },
 {
  "id": 9,
  "lines": [
   "年年岁岁花相似，",
   "岁岁年年人不同。"
  ],
  "by": "刘希夷《代悲白头翁》"
 },
 {
  "id": 10,
  "lines": [
   "闲云潭影日悠悠，",
   "物换星移几度秋。",
   "阁中帝子今何在？",
   "槛外长江空自流。"
  ],
  "by": "王勃《滕王阁诗》"
 },
 {
  "id": 11,
  "lines": [
   "昔人已乘黄鹤去，",
   "此地空余黄鹤楼。",
   "黄鹤一去不复返，",
   "白云千载空悠悠。"
  ],
  "by": "崔颢《黄鹤楼》"
 },
 {
  "id": 12,
  "lines": [
   "此情可待成追忆，",
   "只是当时已惘然。"
  ],
  "by": "李商隐《锦瑟》"
 },
 {
  "id": 13,
  "lines": [
   "向晚意不适，",
   "驱车登古原。",
   "夕阳无限好，",
   "只是近黄昏。"
  ],
  "by": "李商隐《乐游原》"
 },
 {
  "id": 14,
  "lines": [
   "自是寻春去较迟，",
   "不须惆怅怨芳时。",
   "狂风落尽深红色，",
   "绿叶成阴子满枝。"
  ],
  "by": "杜牧《叹花》"
 },
 {
  "id": 15,
  "lines": [
   "盛年不重来，",
   "一日难再晨。",
   "及时当勉励，",
   "岁月不待人。"
  ],
  "by": "陶渊明《杂诗》"
 },
 {
  "id": 16,
  "lines": [
   "对酒当歌，",
   "人生几何！",
   "譬如朝露，",
   "去日苦多。"
  ],
  "by": "曹操《短歌行》"
 },
 {
  "id": 17,
  "lines": [
   "老骥伏枥，志在千里。",
   "烈士暮年，壮心不已。"
  ],
  "by": "曹操《龟虽寿》"
 },
 {
  "id": 18,
  "lines": [
   "百川东到海，",
   "何时复西归？",
   "少壮不努力，",
   "老大徒伤悲。"
  ],
  "by": "汉乐府《长歌行》"
 },
 {
  "id": 19,
  "lines": [
   "生年不满百，",
   "常怀千岁忧。",
   "昼短苦夜长，",
   "何不秉烛游！"
  ],
  "by": "《古诗十九首》"
 },
 {
  "id": 20,
  "lines": [
   "昔我往矣，",
   "杨柳依依。",
   "今我来思，",
   "雨雪霏霏。"
  ],
  "by": "《诗经·小雅·采薇》"
 },
 {
  "id": 21,
  "lines": [
   "大江东去，",
   "浪淘尽，千古风流人物。",
   "人生如梦，",
   "一尊还酹江月。"
  ],
  "by": "苏轼《念奴娇·赤壁怀古》"
 },
 {
  "id": 22,
  "lines": [
   "回首向来萧瑟处，",
   "归去，",
   "也无风雨也无晴。"
  ],
  "by": "苏轼《定风波》"
 },
 {
  "id": 23,
  "lines": [
   "谁道人生无再少？",
   "门前流水尚能西！",
   "休将白发唱黄鸡。"
  ],
  "by": "苏轼《浣溪沙》"
 },
 {
  "id": 24,
  "lines": [
   "世事一场大梦，",
   "人生几度秋凉？"
  ],
  "by": "苏轼《西江月》"
 },
 {
  "id": 25,
  "lines": [
   "而今识尽愁滋味，",
   "欲说还休。",
   "欲说还休，",
   "却道天凉好个秋。"
  ],
  "by": "辛弃疾《丑奴儿》"
 },
 {
  "id": 26,
  "lines": [
   "更能消几番风雨，",
   "匆匆春又归去。",
   "惜春长怕花开早，",
   "何况落红无数。"
  ],
  "by": "辛弃疾《摸鱼儿》"
 },
 {
  "id": 27,
  "lines": [
   "了却君王天下事，",
   "赢得生前身后名。",
   "可怜白发生！"
  ],
  "by": "辛弃疾《破阵子》"
 },
 {
  "id": 28,
  "lines": [
   "三十功名尘与土，",
   "八千里路云和月。",
   "莫等闲，",
   "白了少年头，空悲切！"
  ],
  "by": "岳飞《满江红》"
 },
 {
  "id": 29,
  "lines": [
   "雕栏玉砌应犹在，",
   "只是朱颜改。",
   "问君能有几多愁？",
   "恰似一江春水向东流。"
  ],
  "by": "李煜《虞美人》"
 },
 {
  "id": 30,
  "lines": [
   "去年天气旧亭台，",
   "夕阳西下几时回？",
   "无可奈何花落去，",
   "似曾相识燕归来。"
  ],
  "by": "晏殊《浣溪沙》"
 },
 {
  "id": 31,
  "lines": [
   "试问卷帘人，",
   "却道海棠依旧。",
   "知否，知否？",
   "应是绿肥红瘦。"
  ],
  "by": "李清照《如梦令》"
 },
 {
  "id": 32,
  "lines": [
   "而今听雨僧庐下，",
   "鬓已星星也。",
   "悲欢离合总无情，",
   "一任阶前点滴到天明。"
  ],
  "by": "蒋捷《虞美人·听雨》"
 },
 {
  "id": 33,
  "lines": [
   "何日归家洗客袍？",
   "银字笙调，心字香烧。",
   "流光容易把人抛，",
   "红了樱桃，绿了芭蕉。"
  ],
  "by": "蒋捷《一剪梅》"
 },
 {
  "id": 34,
  "lines": [
   "人生若只如初见，",
   "何事秋风悲画扇。",
   "等闲变却故人心，",
   "却道故人心易变。"
  ],
  "by": "纳兰性德《木兰花令》"
 },
 {
  "id": 35,
  "lines": [
   "滚滚长江东逝水，",
   "浪花淘尽英雄。",
   "是非成败转头空。",
   "青山依旧在，几度夕阳红。"
  ],
  "by": "杨慎《临江仙》"
 },
 {
  "id": 36,
  "lines": [
   "京口瓜洲一水间，",
   "钟山只隔数重山。",
   "春风又绿江南岸，",
   "明月何时照我还？"
  ],
  "by": "王安石《泊船瓜洲》"
 },
 {
  "id": 37,
  "lines": [
   "少年易老学难成，",
   "一寸光阴不可轻。",
   "未觉池塘春草梦，",
   "阶前梧叶已秋声。"
  ],
  "by": "朱熹《偶成》"
 },
 {
  "id": 38,
  "lines": [
   "原来姹紫嫣红开遍，",
   "似这般都付与断井颓垣。",
   "良辰美景奈何天，",
   "赏心乐事谁家院！"
  ],
  "by": "汤显祖《牡丹亭·皂罗袍》"
 },
 {
  "id": 39,
  "lines": [
   "眼看他起朱楼，",
   "眼看他宴宾客，",
   "眼看他楼塌了。"
  ],
  "by": "孔尚任《桃花扇·哀江南》"
 },
 {
  "id": 40,
  "lines": [
   "枯藤老树昏鸦，",
   "小桥流水人家，",
   "古道西风瘦马。",
   "夕阳西下，断肠人在天涯。"
  ],
  "by": "马致远《天净沙·秋思》"
 },
 {
  "id": 41,
  "lines": [
   "人不能两次踏进",
   "同一条河流。"
  ],
  "by": "赫拉克利特"
 },
 {
  "id": 42,
  "lines": [
   "我们并非拥有的时间太少，",
   "而是虚掷的太多。"
  ],
  "by": "塞内加《论生命之短暂》"
 },
 {
  "id": 43,
  "lines": [
   "时间是一条河，",
   "由不断流逝之物汇成，",
   "水势湍急：",
   "一物才现，便被卷走，",
   "另一物又随之而来。"
  ],
  "by": "马可·奥勒留《沉思录》"
 },
 {
  "id": 44,
  "lines": [
   "如海浪奔向卵石的岸，",
   "我们的分分秒秒，",
   "也奔向各自的终点。"
  ],
  "by": "莎士比亚《十四行诗》第六十首"
 },
 {
  "id": 45,
  "lines": [
   "明天，明天，又一个明天，",
   "以琐碎的步子，一天天爬行，",
   "直到时间簿上的最后一个音节。"
  ],
  "by": "莎士比亚《麦克白》"
 },
 {
  "id": 46,
  "lines": [
   "纵然已被夺走许多，",
   "仍有许多留存。"
  ],
  "by": "丁尼生《尤利西斯》"
 },
 {
  "id": 47,
  "lines": [
   "冬天来了，",
   "春天还会远吗？"
  ],
  "by": "雪莱《西风颂》"
 },
 {
  "id": 48,
  "lines": [
   "“看我的功业，强者，",
   "且绝望吧！”",
   "此外，一无所存。"
  ],
  "by": "雪莱《奥西曼迪亚斯》"
 },
 {
  "id": 49,
  "lines": [
   "从一粒沙里看见世界，",
   "从一朵野花里看见天堂，",
   "把无限握在掌心，",
   "让永恒栖于一瞬。"
  ],
  "by": "布莱克《天真的预言》"
 },
 {
  "id": 50,
  "lines": [
   "谁此刻没有房子，",
   "就不必再建造；",
   "谁此刻孤独，",
   "就将长久孤独。"
  ],
  "by": "里尔克《秋日》"
 },
 {
  "id": 51,
  "lines": [
   "永恒，",
   "是由无数个“现在”组成的。"
  ],
  "by": "艾米莉·狄金森"
 },
 {
  "id": 52,
  "lines": [
   "于我，白昼与黑夜的每一个钟点，",
   "都是奇迹。"
  ],
  "by": "惠特曼《草叶集》"
 },
 {
  "id": 53,
  "lines": [
   "当你老了，头发花白，睡意沉沉，",
   "在炉火旁打盹，",
   "请取下这本书，慢慢读，",
   "梦见你眼中曾有的柔光。"
  ],
  "by": "叶芝《当你老了》"
 },
 {
  "id": 54,
  "lines": [
   "我用咖啡匙，",
   "量过我的人生。"
  ],
  "by": "艾略特《普鲁弗洛克的情歌》"
 },
 {
  "id": 55,
  "lines": [
   "你热爱生命吗？",
   "那就别浪费时间，",
   "因为时间，正是生命的材料。"
  ],
  "by": "本杰明·富兰克林"
 },
 {
  "id": 56,
  "lines": [
   "把它写在你的心上：",
   "每一天，都是一年中最好的一天。"
  ],
  "by": "爱默生"
 },
 {
  "id": 57,
  "lines": [
   "时间，不过是我垂钓的溪流。",
   "我啜饮其水，却看见水底的沙床，",
   "发觉它如此之浅；",
   "而细流逝去，永恒留下。"
  ],
  "by": "梭罗《瓦尔登湖》"
 },
 {
  "id": 58,
  "lines": [
   "对那一瞬间我要说：",
   "停一停吧，你真美丽！"
  ],
  "by": "歌德《浮士德》"
 },
 {
  "id": 59,
  "lines": [
   "那么，时间是什么？",
   "无人问我，我倒清楚；",
   "一旦要我向人解说，",
   "我便茫然无知。"
  ],
  "by": "奥古斯丁《忏悔录》"
 },
 {
  "id": 60,
  "lines": [
   "抓住今天，",
   "尽量少把希望，",
   "托付给明天。"
  ],
  "by": "贺拉斯《颂歌》"
 },
 {
  "id": 61,
  "lines": [
   "有智慧的人，",
   "每天都在重塑自己的认知。",
   "没有智慧的人，",
   "一生都在捍卫自己的认知。"
  ],
  "by": ""
 },
 {
  "id": 62,
  "lines": [
   "记住，当你死的时候，",
   "你并不知道自己已经死了。",
   "感到痛苦的只有别人。",
   "当你愚蠢的时候，",
   "也是同样的道理。"
  ],
  "by": "瑞奇·热维斯"
 }
]